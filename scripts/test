#!/usr/bin/env bash
# scripts/test <name> podman | scripts/test <name> srun [srun flags...]: run tools/<name>'s candidate's
# test by digest, under podman here or under srun with pyxis from a cluster's login node, and write
# its record, results/<name>/<version>.txt. Exits with the test's exit code.
set -euo pipefail
usage() { echo "usage: scripts/test <name> podman | scripts/test <name> srun [srun flags...]" >&2; exit 2; }
[[ $# -ge 2 ]] || usage
name=$1 runner=$2; shift 2
cd "$(dirname "$0")/.."
ref=$(python3 -I scripts/check.py --resolve "tools/$name")
version=$(python3 -I -c "import sys; sys.path.insert(0, 'scripts'); import check, pathlib; print(check.frontmatter(pathlib.Path('tools/$name/SKILL.md'))['metadata']['version'])")
inner='echo "node: $(hostname)"; nvidia-smi -L 2>/dev/null || echo "gpu: none"; bash /toolshed/test/run.sh'
case "$runner" in
  podman)
    [[ $# -eq 0 ]] || usage
    gpu=()
    command -v nvidia-smi > /dev/null && gpu=(--device nvidia.com/gpu=all)
    cmd=(podman run --rm --network none ${gpu[@]+"${gpu[@]}"} "$ref" bash -c "$inner")
    desc=podman ;;
  srun)
    cmd=(srun "$@" --container-image="${ref/\//#}" bash -c "$inner")
    desc="srun${*:+ $*}" ;;
  *) usage ;;
esac
started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
out=$(mktemp)
set +e
"${cmd[@]}" 2>&1 | tee "$out"
code=${PIPESTATUS[0]}
set -e
mkdir -p "results/$name"
{
  printf -- '---\n'
  printf 'tool: %s\nversion: %s\nimage: %s\ndigest: %s\n' "$name" "$version" "$ref" "${ref#*@}"
  printf 'runner: %s\nhost: %s\nstarted: %s\nexit: %s\n' "$desc" "$(hostname -f 2> /dev/null || hostname)" "$started" "$code"
  printf -- '---\n'
  cat "$out"
} > "results/$name/$version.txt"
rm -f "$out"
echo "record: results/$name/$version.txt (exit $code)"
exit "$code"
