FROM docker.io/pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 DPLM_MODEL=/opt/model
# Pip-free and split into small steps, each one a cacheable layer: the build
# host has killed builds mid-step at every stage, never with an error of their
# own, so a killed build must lose only the step it died in and the next
# submission rides the cache of every step that finished. pip died on that
# host twice -- once installing from the package index, once installing these
# very wheels with --no-index --no-deps, each time right after pip's root-user
# warning and before any error of its own -- so the wheels are unpacked
# instead with python's own zipfile, into /opt/vendor, a directory of its own:
# the base image's site-packages (its torch, and torch's dependencies) stay
# untouched, and bin/dplm and test/check.py put /opt/vendor at the front of
# sys.path ahead of them. The weights are airkingbd/dplm_150m's 595 MB fp32
# checkpoint: fetch_weights.py fetches it over the one network route every
# build proved (plain resolve URLs), verifies every file against its pinned
# sha256, and leaves it exactly as released -- the wrapper casts it to bf16 at
# load, the same cast the test's reference map was computed with.
COPY wheels /incoming/wheels/
RUN cd /incoming/wheels && sha256sum --quiet -c SHA256SUMS && echo "dplm build: vendored wheels verified"
RUN mkdir -p /opt/vendor && for w in /incoming/wheels/*.whl; do echo "dplm build: unpacking $(basename "$w")"; python3 -I -m zipfile -e "$w" /opt/vendor/; done && echo "dplm build: vendored wheels unpacked under /opt/vendor"
COPY src /opt/src
COPY --chmod=755 bin/dplm /usr/local/bin/dplm
COPY LICENSE fetch_weights.py /incoming/
RUN echo "dplm build: checking the unpacked environment" && python3 -I -c "import sys; sys.path.insert(0, '/opt/vendor'); import transformers, tokenizers, huggingface_hub, safetensors, numpy; assert (transformers.__version__, tokenizers.__version__, huggingface_hub.__version__, safetensors.__version__, numpy.__version__) == ('4.51.3', '0.21.1', '0.30.2', '0.5.3', '2.5.4'), 'the vendored wheels did not unpack as pinned'"
RUN python3 -I /incoming/fetch_weights.py /opt/model && cp /incoming/LICENSE /opt/model/LICENSE && echo "dplm build: weights fetched, verified, licensed"
RUN rm -rf /incoming && ls -l /opt/model
COPY test /toolshed/test
