FROM docker.io/pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 DPLM_MODEL=/opt/model
# One quiet RUN does the whole build (build.sh): the pinned packages, then the pinned
# weights -- airkingbd/dplm_150m's 595 MB fp32 checkpoint, fetched sha256-verified into
# /opt/model and stored exactly as released, cast to bf16 at load, the same cast the
# test's reference map was computed with -- then the committed files laid into the image
# (the vendored modeling code under /opt/src, the wrapper on PATH, the license beside the
# weights). Silent on success, loud on failure: the build log stays short enough to be
# read whole, so a build that dies says why.
COPY src bin LICENSE fetch_weights.py build.sh /incoming/
RUN bash /incoming/build.sh
COPY test /toolshed/test
