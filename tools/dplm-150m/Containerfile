FROM docker.io/pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 DPLM_MODEL=/opt/model
# One RUN does the whole build (build.sh), naming each stage as it starts, so a build
# that dies says where. The environment is requirements.txt: the closed set of packages,
# each wheel sha256-pinned. The fetch pulls the pinned weights -- airkingbd/dplm_150m's 595 MB fp32
# checkpoint, sha256-verified into /opt/model and stored exactly as released, cast to
# bf16 at load, the same cast the test's reference map was computed with -- then the
# committed files are laid into the image: the vendored modeling code under /opt/src,
# the wrapper on PATH, the license beside the weights. Each directory is copied to the
# path build.sh reads it from: COPY copies a directory's contents, not the directory,
# so a directory source sent to a shared destination would lose its name (1.0.3's one
# COPY into /incoming/ never created the /incoming/src its build.sh read -- no build
# reached the cp that would have said so).
COPY src /incoming/src/
COPY bin /incoming/bin/
COPY LICENSE fetch_weights.py build.sh requirements.txt /incoming/
RUN bash /incoming/build.sh
COPY test /toolshed/test
