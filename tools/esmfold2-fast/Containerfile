# ESMFold2-Fast through the esm package 3.5.0 (torch >= 2.11, Python >= 3.12), on PyTorch 2.14.1's CUDA 13.0
# build, the base esmc-6b stands on; CUDA 13 wheels carry Blackwell's kernels as well as Ampere's to Hopper's.
FROM docker.io/pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
# Triton compiles a small C driver shim on first use; the runtime base has no C compiler.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*
# The base ships spin, NumPy's build frontend, whose click<8.4 conflicts with the hf CLI's click>=8.4.2 (as
# esmc-6b found); nothing at runtime imports it, so it goes first and pip skips the installed-conflict report.
RUN (pip uninstall -y --break-system-packages spin || true) \
 && pip install --no-cache-dir --break-system-packages --no-warn-conflicts "esm==3.5.0"
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 ESMFOLD2_MODEL=/opt/model ESMCFOLD_CCD_PATH=/opt/model/ccd.pkl \
    ESMFOLD2_LOOPS=3 ESMFOLD2_STEPS=50
COPY build_shards.py /usr/local/bin/build-shards
COPY shard_plan.json /usr/local/share/esmfold2-shard-plan.json
COPY --chmod=755 bin/esmfold2 /usr/local/bin/esmfold2
COPY LICENSE.md THIRD_PARTY_NOTICE.md /opt/model/
# The model's small files from the pinned Fast revision, and the CCD pickle from the full model's revision
# (the Fast repository carries none), through the hf CLI esm installs.
RUN HF_HUB_OFFLINE=0 hf download biohub/ESMFold2-Fast config.json tokenizer.json tokenizer_config.json \
      --revision 45fe8656f5b3ef493c17fcf9abe9a2968902e712 --local-dir /opt/model \
 && HF_HUB_OFFLINE=0 hf download biohub/ESMFold2 ccd.pkl --revision 69869f737beffec5294845ede23db5fc0b4f509e --local-dir /opt/model \
 && rm -rf /opt/model/.cache
# The weights as 105 bounded shards, one RUN each, from shard_plan.json (made by make_shard_plan.py from the
# pinned revision's six fp32 safetensors, each checked against the Hub's LFS sha256): each RUN fetches its
# span in parallel ranges, checks the span's sha256, writes it as a shard, casts the ESM C backbone's esmc.*
# tensors to bf16 and leaves the folding layers fp32, and verifies the result. A build that dies resumes at
# its first missing shard from the layer cache.
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 0
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 1
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 2
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 3
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 4
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 5
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 6
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 7
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 8
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 9
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 10
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 11
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 12
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 13
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 14
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 15
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 16
RUN python3 -I -u /usr/local/bin/build-shards --plan /usr/local/share/esmfold2-shard-plan.json --shard 17
