FROM docker.io/pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
RUN pip install --no-cache-dir --break-system-packages transformers==5.20.2 huggingface_hub==2.3.0 numpy==2.5.4
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 ESM2_MODEL=/opt/model
# The weights are facebook/esm2_t36_3B_UR50D's two fp32 shards (11.4 GB, as released)
# at revision 476b6399, crossed in eighty-six verified 128 MiB byte ranges, one
# short RUN per chunk (the pattern protbert 1.0.3 proved on this builder): each
# range's sha256 is checked before its layer is committed, a stalled step resumes from
# the bytes it already holds, and a build that dies reuses whatever the builder cached,
# so progress survives. The wrapper assembles each shard's parts at load time, checks
# the whole file's sha256, and loads them in bf16 for contacts (the same rounding
# oplm's own computation runs on) and fp32 for pll, embed and fill. The small files --
# config, shard index, tokenizer, vocab, and Meta's MIT LICENSE -- are committed in
# model/ and copied in after the chunks, so a change to them never invalidates a cached
# chunk, and the test is last, per the conventions.
COPY fetch_chunk.py /tmp/fetch_chunk.py
RUN python3 -I /tmp/fetch_chunk.py 0
RUN python3 -I /tmp/fetch_chunk.py 1
