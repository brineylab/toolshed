# ESM-IF1 (facebookresearch/esm, MIT), pinned before the upstream archive.
# Upstream recommends PyTorch with PyG and biotite. The GVP encoder uses
# torch_geometric's pure-Python MessagePassing; its optional torch_scatter
# import is behind a branch that this model does not use (attention_heads=0).
FROM docker.io/pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV HF_HUB_OFFLINE=1
# ESM-IF1's legacy checkpoints are plain torch.save dictionaries; the
# explicitly selected upstream load path uses torch.load(map_location="cpu").
ENV TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
# Biotite 1.5.0 removed the legacy PDBxFile and filter_peptide_backbone names
# imported by the pinned ESM code. 0.41.2 has both and supports Python 3.12;
# keep numpy 1.x. The official PyPI wheel imports under Python 3.12 in this
# stack; it does not need the later biotraj dependency or a build toolchain.
RUN pip install --no-cache-dir --break-system-packages \
      numpy==1.26.4 scipy==1.15.3 biotite==0.41.2 \
      torch-geometric==2.8.1
# The runtime base can also carry the incompatible modern `esm` library. Pin
# an interpreter path override now, before importing any compiled biotite
# extension in a build-time check. A .pth file keeps the archived 2022 package
# first even under `python3 -I`; PYTHONPATH and caller packages cannot replace
# it. Upstream is a library here, not a CLI.
RUN python3 -I -c "import pathlib, sysconfig; (pathlib.Path(sysconfig.get_paths()['purelib'])/'esm-if1.pth').write_text('/opt/esm\\n')" \
  && ln -s /usr/local/lib/python3.12/dist-packages /usr/local/lib/python3.12/site-packages \
  && python3 -I -c "import pathlib, shutil, tarfile, urllib.request; sha='2b369911bb5b4b0dda914521b9475cad1656b2ac'; root=pathlib.Path('/tmp/esm-source'); root.mkdir(); urllib.request.urlretrieve(f'https://github.com/facebookresearch/esm/archive/{sha}.tar.gz','/tmp/esm.tar.gz'); tarfile.open('/tmp/esm.tar.gz').extractall(root); out=pathlib.Path('/opt/esm'); out.mkdir(); (root/f'esm-{sha}'/'esm').rename(out/'esm'); shutil.rmtree(root); pathlib.Path('/tmp/esm.tar.gz').unlink()" \
  && python3 -I -c "import esm.inverse_folding, biotite, torch, torch_geometric; import esm; assert esm.__file__.startswith('/opt/esm/'), esm.__file__; print(esm.__file__, 'biotite', biotite.__version__, 'torch', torch.__version__, 'pyg', torch_geometric.__version__)"
COPY LICENSE /opt/model/LICENSE
# Weights last: 1.70 GB, downloaded only into this layer, with the exact bytes
# verified before the container test tries loading the model.
RUN python3 -I -c "import hashlib, pathlib, urllib.request; p=pathlib.Path('/opt/model/esm_if1_gvp4_t16_142M_UR50.pt'); p.parent.mkdir(exist_ok=True); urllib.request.urlretrieve('https://dl.fbaipublicfiles.com/fair-esm/models/esm_if1_gvp4_t16_142M_UR50.pt',p); assert hashlib.sha256(p.read_bytes()).hexdigest()=='be4ba36edec22a9bfaa4946ff6b2815f1f19d8a3d7e0eada8b796d5a0eae9fd4'" \
  && python3 -I -c "import esm; m,a=esm.pretrained.load_model_and_alphabet_local('/opt/model/esm_if1_gvp4_t16_142M_UR50.pt'); print(sum(p.numel() for p in m.parameters()), 'parameters; checkpoint loads')"
COPY --chmod=755 bin/esm-if1 /usr/local/bin/esm-if1
COPY test /toolshed/test
