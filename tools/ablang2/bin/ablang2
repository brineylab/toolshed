#!/usr/bin/env -S python3 -I
"""ablang2: paired pseudo-log-likelihoods, embeddings, infilling, and per-position amino-acid matrices."""
import argparse
import os
import sys
import time

import ablang2
import numpy as np
import torch

RESIDUES = "ACDEFGHIKLMNPQRSTVWY"
BATCH = 32


def read_fasta(path, allow_mask=False):
    records = []
    with open(path) as handle:
        for line in handle:
            line = line.strip()
            if line.startswith(">"):
                name = line[1:].split()[0] if line[1:].strip() else f"seq{len(records) + 1}"
                if any(name == old for old, _ in records):
                    sys.exit(f"ablang2: {name} appears twice in {path}; ids must be unique")
                records.append([name, ""])
            elif line:
                if not records:
                    sys.exit(f"ablang2: {path} is not FASTA: sequence before the first '>'")
                if allow_mask:
                    sequence = line.upper().replace("<MASK>", "*")
                else:
                    sequence = line.upper()
                records[-1][1] += sequence
    if not records:
        sys.exit(f"ablang2: {path} holds no sequences")
    for name, sequence in records:
        allowed = set(RESIDUES + ("*" if allow_mask else ""))
        outside = "".join(sorted(set(sequence) - allowed))
        if outside or not sequence.replace("*", ""):
            sys.exit(f"ablang2: {name} in {path} is empty or holds unsupported characters: {outside}")
    return records


def read_pairs(heavy_path, light_path, fill=False):
    heavy = read_fasta(heavy_path, allow_mask=fill)
    light = dict(read_fasta(light_path, allow_mask=fill))
    missing = [name for name, _ in heavy if name not in light]
    extra = set(light) - {name for name, _ in heavy}
    if missing or extra:
        sys.exit(f"ablang2: heavy/light ids differ; missing light={missing}, missing heavy={sorted(extra)}")
    return [(name, sequence, light[name]) for name, sequence in heavy]


def encode(model, pair, device, fill=False):
    _, heavy, light = pair
    # Upstream pretrained.py:add_extra_tokens and models/ablang2/vocab.py:
    # heavy first, light second, '<' and '>' at the chain ends, and '|' between chains.
    text = f"<{heavy}>|<{light}>"
    ids = model.tokenizer(text, pad=True, w_extra_tkns=False, device=device)
    special_tokens = model.tokenizer.all_special_tokens
    if fill:
        # Input masks occupy residue positions; output masks do not.
        special_tokens = [token for token in special_tokens
                          if token != model.tokenizer.mask_token]
    residue_positions = torch.tensor(
        [i for i, token in enumerate(ids[0].tolist())
         if token not in special_tokens],
        dtype=torch.long, device=device)
    assert len(residue_positions) == len(heavy) + len(light)
    return ids, residue_positions


def forward(model, ids):
    return model.AbLang(ids)


def residue_logp(model, tokens, allowed, batch_size):
    """Mask each residue in turn and return its (L, 20) natural-log-probability matrix."""
    ids, positions = tokens
    rows = []
    for start in range(0, len(positions), batch_size):
        pos = positions[start:start + batch_size]
        batch = ids.repeat(len(pos), 1)
        batch[torch.arange(len(pos), device=ids.device), pos] = model.tokenizer.mask_token
        logits = forward(model, batch)[torch.arange(len(pos), device=ids.device), pos]
        rows.append(logits[:, allowed].log_softmax(-1))
    return torch.cat(rows).float().cpu().numpy()


def embedding(model, tokens):
    ids, positions = tokens
    return model.AbRep(ids).last_hidden_states[0, positions].mean(0).float().cpu().numpy()


def fill(model, pair, tokens, allowed):
    (name, heavy, light), (ids, positions) = pair, tokens
    logits = forward(model, ids)[0][:, allowed]
    # Start with the caller's residues, not a decode of the model's output:
    # only masked positions are predictions; every other residue is input.
    residues = list(heavy + light)
    for index, position in enumerate(positions.tolist()):
        if ids[0, position] == model.tokenizer.mask_token:
            residues[index] = RESIDUES[int(allowed[logits[position].argmax(-1)])]
    return name, "".join(residues[:len(heavy)]) + "|" + "".join(residues[len(heavy):])


def main():
    parser = argparse.ArgumentParser(prog="ablang2", description=__doc__)
    sub = parser.add_subparsers(dest="cmd", required=True)
    for command, output in (("pll", "TSV: id, pll"), ("embed", "npz: ids, embeddings"),
                            ("fill", "FASTA"), ("matrix", "npz: per-id (L, 20) matrices")):
        p = sub.add_parser(command)
        p.add_argument("--heavy", required=True, help="heavy-chain FASTA")
        p.add_argument("--light", required=True, help="light-chain FASTA, matched by id")
        p.add_argument("--out", required=True, help=output)
        p.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
    args = parser.parse_args()
    read_time = time.monotonic()
    pairs = read_pairs(args.heavy, args.light, fill=args.cmd == "fill")
    model = ablang2.pretrained(model_to_use=os.environ["ABLANG2_MODEL"],
                               random_init=False, ncpu=1, device=args.device)
    loaded_time = time.monotonic()
    if args.device == "cuda" and not torch.cuda.is_available():
        sys.exit("ablang2: --device cuda was requested, but no CUDA device is available")
    model.AbLang.eval()
    residues = sum(len(heavy) + len(light) for _, heavy, light in pairs)
    print(f"ablang2: {len(pairs)} pair(s), {residues} residues; device={args.device}; "
          f"model_load_seconds={loaded_time - read_time:.3f}; "
          f"input_bytes={os.path.getsize(args.heavy) + os.path.getsize(args.light)}", flush=True)
    residue_tokens = model.tokenizer.aa_to_token
    allowed = torch.tensor([residue_tokens[aa] for aa in RESIDUES], device=args.device)
    tokens = [encode(model, pair, args.device, fill=args.cmd == "fill") for pair in pairs]
    with torch.inference_mode():
        if args.cmd == "embed":
            np.savez(args.out, ids=np.array([p[0] for p in pairs]),
                     embeddings=np.stack([embedding(model, token) for token in tokens]).astype(np.float32))
        elif args.cmd == "fill":
            with open(args.out, "w") as handle:
                for pair, token in zip(pairs, tokens):
                    name, joined = fill(model, pair, token, allowed)
                    handle.write(f">{name}\n{joined}\n")
        else:
            matrices = [residue_logp(model, token, allowed, BATCH) for token in tokens]
            if args.cmd == "pll":
                with open(args.out, "w") as handle:
                    handle.write("id\tpll\n")
                    for pair, token, matrix in zip(pairs, tokens, matrices):
                        _, positions = token
                        ids = token[0][0, positions].detach().cpu().tolist()
                        columns = np.array([RESIDUES.index(model.tokenizer.token_to_aa[i]) for i in ids])
                        pll = float(matrix[np.arange(len(ids)), columns].sum())
                        handle.write(f"{pair[0]}\t{pll:.4f}\n")
            else:
                maps = {pair[0]: matrix.astype(np.float32) for pair, matrix in zip(pairs, matrices)}
                np.savez(args.out, ids=np.array([p[0] for p in pairs]),
                         amino_acids=np.array(list(RESIDUES)), **maps)
    compute_seconds = time.monotonic() - loaded_time
    print(f"ablang2: compute_seconds={compute_seconds:.3f}; "
          f"residues_per_second={residues / compute_seconds:.3f}", flush=True)
    if args.device == "cuda":
        print(f"ablang2: gpu={torch.cuda.get_device_name(0)}; "
              f"peak_gpu_memory_gib={torch.cuda.max_memory_allocated() / 2**30:.3f}", flush=True)


if __name__ == "__main__":
    main()
