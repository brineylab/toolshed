#!/usr/bin/env -S python3 -I
"""antiberty: single-chain pseudo-log-likelihoods, embeddings, infilling, and mutation matrices."""
import argparse
import os
import sys
import time

from antiberty import AntiBERTyRunner
import numpy as np
import torch

RESIDUES = "ACDEFGHIKLMNPQRSTVWY"
MAX_RESIDUES = 510
BATCH = 32


def read_fasta(path, allow_mask=False):
    records = []
    with open(path) as handle:
        for line in handle:
            line = line.strip()
            if line.startswith(">"):
                name = line[1:].split()[0] if line[1:].strip() else f"seq{len(records) + 1}"
                if any(name == old for old, _ in records):
                    sys.exit(f"antiberty: {name} appears twice in {path}; ids must be unique")
                records.append([name, ""])
            elif line:
                if not records:
                    sys.exit(f"antiberty: {path} is not FASTA: sequence before the first '>'")
                records[-1][1] += line.upper().replace("<MASK>", "_") if allow_mask else line.upper()
    if not records:
        sys.exit(f"antiberty: {path} holds no sequences")
    for name, sequence in records:
        allowed = set(RESIDUES + ("_" if allow_mask else ""))
        outside = "".join(sorted(set(sequence) - allowed))
        if outside or not sequence.replace("_", ""):
            sys.exit(f"antiberty: {name} in {path} is empty or holds unsupported characters: {outside}")
        if len(sequence) > MAX_RESIDUES:
            sys.exit(f"antiberty: {name} has {len(sequence)} residues; the model takes at most {MAX_RESIDUES}")
    return records


def main():
    parser = argparse.ArgumentParser(prog="antiberty", description=__doc__)
    sub = parser.add_subparsers(dest="cmd", required=True)
    for command, output in (("pll", "TSV: id, pll"), ("embed", "npz: ids, embeddings"),
                            ("fill", "FASTA"), ("matrix", "npz: per-id (L, 20) matrices")):
        p = sub.add_parser(command)
        p.add_argument("--in", dest="inp", required=True, help="single-chain FASTA")
        p.add_argument("--out", required=True, help=output)
        p.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
        if command in ("pll", "matrix"):
            p.add_argument("--normalize", choices=("standard", "full-vocab"), default="standard",
                           help="standard: normalize over 20 amino acids; full-vocab: retain upstream's special-token logits")
    args = parser.parse_args()
    if args.inp == "-" or args.out == "-":
        sys.exit("antiberty: inputs and outputs must be file paths, not '-'")
    if args.device == "cuda" and not torch.cuda.is_available():
        sys.exit("antiberty: --device cuda was requested, but no CUDA device is available")
    normalization = getattr(args, "normalize", "standard")
    read_time = time.monotonic()
    records = read_fasta(args.inp, allow_mask=args.cmd == "fill")
    runner = AntiBERTyRunner(device=args.device, checkpoint_path=os.environ["ANTIBERTY_WEIGHTS_DIR"])
    model = runner.model
    tokenizer = runner.tokenizer
    loaded_time = time.monotonic()
    length = sum(len(sequence) for _, sequence in records)
    print(f"antiberty: {len(records)} sequence(s), {length} residues; device={args.device}; "
          f"model_load_seconds={loaded_time - read_time:.3f}; input_bytes={os.path.getsize(args.inp)}", flush=True)
    allowed = torch.tensor([tokenizer.token_to_id[aa] for aa in RESIDUES], device=model.device)
    special = torch.tensor(tokenizer.all_special_ids, device=model.device)

    def logits(sequences):
        encoded = tokenizer(sequences)
        input_ids = encoded["input_ids"].to(model.device)
        attention_mask = encoded["attention_mask"].to(model.device)
        out = model(input_ids=input_ids, attention_mask=attention_mask, output_hidden_states=args.cmd == "embed")
        return out, input_ids

    with torch.inference_mode():
        if args.cmd == "embed":
            embeddings = []
            for _, seq in records:
                out, _ = logits([seq])
                embeddings.append(out.hidden_states[-1][0, 1:-1].mean(0).float().cpu().numpy())
            np.savez(args.out, ids=np.array([name for name, _ in records]),
                     embeddings=np.stack(embeddings).astype(np.float32))
        elif args.cmd == "fill":
            out, input_ids = logits([seq for _, seq in records])
            with open(args.out, "w") as handle:
                for i, (name, seq) in enumerate(records):
                    masked = input_ids[i, 1:len(seq) + 1] == tokenizer.mask_token_id
                    predictions = out.prediction_logits[i, 1:len(seq) + 1][:, allowed].argmax(-1)
                    chars = [RESIDUES[p] if m else c for c, m, p in zip(seq, masked.tolist(), predictions.tolist())]
                    handle.write(f">{name}\n{''.join(chars)}\n")
        else:
            matrices, plls = [], []
            for _, seq in records:
                tokens = tokenizer.encode(seq)[1:-1]
                rows = []
                for start in range(0, len(seq), BATCH):
                    masked = [seq[:i] + "_" + seq[i + 1:] for i in range(start, min(start + BATCH, len(seq)))]
                    out, _ = logits(masked)
                    positions = torch.arange(len(masked), device=model.device)
                    selected = out.prediction_logits[positions,
                                   torch.arange(start + 1, start + 1 + len(masked), device=model.device)].clone()
                    if normalization == "standard":
                        selected = selected[:, allowed]
                    else:
                        selected[:, special] = -float("inf")
                        selected = selected[:, allowed]
                    rows.append(selected.log_softmax(-1).float().cpu().numpy())
                matrix = np.concatenate(rows)
                matrices.append(matrix)
                ids = torch.tensor(tokens, device="cpu")
                columns = torch.tensor([RESIDUES.index(tokenizer.convert_ids_to_tokens([i])[0]) for i in ids.tolist()])
                plls.append(float(matrix[np.arange(len(seq)), columns.numpy()].sum()))
            if args.cmd == "pll":
                with open(args.out, "w") as handle:
                    handle.write("id\tpll\n")
                    for (name, _), pll in zip(records, plls):
                        handle.write(f"{name}\t{pll:.6f}\n")
            else:
                arrays = {name: matrix.astype(np.float32) for (name, _), matrix in zip(records, matrices)}
                np.savez(args.out, ids=np.array([name for name, _ in records]),
                         amino_acids=np.array(list(RESIDUES)), **arrays)
    compute_seconds = time.monotonic() - loaded_time
    if args.cmd in ("pll", "matrix"):
        print(f"antiberty: normalization={normalization}", flush=True)
    print(f"antiberty: compute_seconds={compute_seconds:.3f}; residues_per_second={length / compute_seconds:.3f}", flush=True)
    if args.device == "cuda":
        print(f"antiberty: gpu={torch.cuda.get_device_name(0)}; "
              f"peak_gpu_memory_gib={torch.cuda.max_memory_allocated() / 2**30:.3f}", flush=True)


if __name__ == "__main__":
    main()
