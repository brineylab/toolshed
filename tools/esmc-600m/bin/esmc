#!/usr/bin/env -S python3 -I
"""esmc: pseudo-log-likelihoods, embeddings, masked infilling, and contact maps with the ESM C model in $ESMC_MODEL."""
import argparse, os, sys

import numpy as np
import torch
from transformers import AutoTokenizer, EsmcForMaskedLM
from transformers.utils import logging

logging.disable_progress_bar()

MAX_RESIDUES = 2046  # the model's 2048 positions, less <cls> and <eos>
BATCH = 32           # masked copies per forward pass in pll
RESIDUES = "ACDEFGHIKLMNPQRSTVWY"
CONTACTS_MAX_RESIDUES = 818  # plm-evals' longest structure eval set
CONTACTS_BATCH = 64          # substituted residues per forward pass in contacts
# oplm's canonical amino-acid order (oplm commit 704e01f, src/oplm/eval/metrics/
# categorical_jacobian.py). The substituted residues (J's axis 1) and the output
# logits (axis 3) both use it, so the 4-D symmetrization pairs like with like.
CANONICAL_AMINO_ACIDS = (
    "L", "A", "G", "V", "S", "E", "R", "T", "I", "D",
    "P", "K", "Q", "N", "F", "Y", "M", "H", "W", "C",
)


def read_fasta(path):
    records = []
    for line in open(path):
        line = line.strip()
        if line.startswith(">"):
            records.append([line[1:].split()[0] if line[1:].strip() else f"seq{len(records) + 1}", ""])
        elif line:
            if not records:
                sys.exit(f"esmc: {path} is not FASTA: sequence before the first '>'")
            records[-1][1] += line.upper().replace("<MASK>", "<mask>").replace("_", "<mask>")
    if not records:
        sys.exit(f"esmc: {path} holds no sequences")
    return records


def encode(tok, name, seq, device):
    ids = tok(seq, return_tensors="pt")["input_ids"].to(device)
    if ids.shape[1] - 2 > MAX_RESIDUES:
        sys.exit(f"esmc: {name} has {ids.shape[1] - 2} residues; the model takes at most {MAX_RESIDUES}")
    return ids


def pll(model, tok, ids):
    """Each position masked in turn; the true residue's log-probability there, summed."""
    total, L = 0.0, ids.shape[1] - 2
    for start in range(1, L + 1, BATCH):
        pos = torch.arange(start, min(start + BATCH, L + 1), device=ids.device)
        rows = torch.arange(len(pos), device=ids.device)
        batch = ids.repeat(len(pos), 1)
        batch[rows, pos] = tok.mask_token_id
        logp = model(input_ids=batch).logits.log_softmax(-1)
        total += logp[rows, pos, ids[0, pos]].sum().item()
    return total


def embed(model, ids):
    """The last layer, mean-pooled over residues."""
    return model.base_model(input_ids=ids).last_hidden_state[0, 1:-1].mean(0).float().cpu().numpy()


def fill(model, tok, ids):
    """Every <mask> replaced by the most likely of the 20 standard residues."""
    allowed = torch.tensor(tok.convert_tokens_to_ids(list(RESIDUES)), device=ids.device)
    logits = model(input_ids=ids).logits[0][:, allowed]
    out = ids[0].clone()
    masked = out == tok.mask_token_id
    out[masked] = allowed[logits[masked].argmax(-1)]
    return "".join(tok.convert_ids_to_tokens(out[1:-1].tolist()))


def apply_apc(matrix):
    """Average Product Correction, as oplm's apply_apc does it (commit 704e01f)."""
    row_mean = matrix.mean(dim=-1, keepdim=True)
    col_mean = matrix.mean(dim=-2, keepdim=True)
    global_mean = matrix.mean()
    if global_mean.abs() < 1e-8:
        return matrix
    return matrix - (row_mean * col_mean) / global_mean


def reduce_jacobian(jacobian):
    """Reduce an (L, 20, L, 20) Jacobian to an (L, L) contact map, as oplm's
    categorical_jacobian_to_contact_map does it (commit 704e01f): center over all
    four axes, symmetrize, square root of the sum of squares over the two amino-acid
    axes, zero the diagonal, APC, symmetrize the (L, L) map."""
    jacobian = jacobian.float()
    for dim in range(4):
        jacobian -= jacobian.mean(dim=dim, keepdim=True)
    jacobian = (jacobian + jacobian.permute(2, 3, 0, 1)) / 2
    scores = torch.sqrt(torch.square(jacobian).sum(dim=(1, 3)))
    scores.fill_diagonal_(0.0)
    scores = apply_apc(scores)
    return (scores + scores.T) / 2


def contacts(model, tok, name, ids, seq):
    """The (L, L) contact map from the categorical Jacobian, as oplm computes it:
    substitute each of the 20 canonical amino acids at each residue position (no
    masking), subtract the wild-type logits, reduce. The forward pass runs in bf16
    (the caller loads the model in bf16); the Jacobian and the reduction are fp32."""
    if set(seq) - set(RESIDUES):
        sys.exit(f"esmc: contacts: {name} holds residues outside the 20 canonical ones: "
                 f"{''.join(sorted(set(seq) - set(RESIDUES)))}")
    L = ids.shape[1] - 2
    if L > CONTACTS_MAX_RESIDUES:
        sys.exit(f"esmc: contacts: {name} has {L} residues; contacts takes at most {CONTACTS_MAX_RESIDUES}")
    canonical = torch.tensor([tok.encode(aa, add_special_tokens=False)[0] for aa in CANONICAL_AMINO_ACIDS],
                             device=ids.device)
    wildtype = model(input_ids=ids).logits[0, 1:L + 1].index_select(-1, canonical).float()
    jacobian = torch.empty((L, 20, L, 20), dtype=torch.float32, device=ids.device)
    for start in range(0, L * 20, CONTACTS_BATCH):
        stop = min(start + CONTACTS_BATCH, L * 20)
        idx = torch.arange(start, stop, device=ids.device)
        pos, aas = torch.div(idx, 20, rounding_mode="floor"), torch.remainder(idx, 20)
        batch = ids.repeat(stop - start, 1)
        batch[torch.arange(stop - start, device=ids.device), pos + 1] = canonical[aas]
        logits = model(input_ids=batch).logits[:, 1:L + 1].index_select(-1, canonical).float()
        jacobian[pos, aas] = logits - wildtype
    return reduce_jacobian(jacobian).cpu().numpy().astype(np.float32)


def main():
    ap = argparse.ArgumentParser(prog="esmc", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for cmd, out in (("pll", "TSV: id, pll"), ("embed", "npz: ids, embeddings"), ("fill", "FASTA"),
                     ("contacts", "npz: one (L, L) float32 map per id")):
        p = sub.add_parser(cmd)
        p.add_argument("--in", dest="inp", required=True, help="FASTA")
        p.add_argument("--out", required=True, help=out)
        p.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
    args = ap.parse_args()

    records = read_fasta(args.inp)
    tok = AutoTokenizer.from_pretrained(os.environ["ESMC_MODEL"])
    # oplm's contacts computation runs the forward pass in bf16; the other commands
    # keep the weights' stored precision.
    model = EsmcForMaskedLM.from_pretrained(
        os.environ["ESMC_MODEL"], dtype=torch.bfloat16 if args.cmd == "contacts" else None,
    ).eval().to(args.device)
    with torch.inference_mode():
        results = [(name, encode(tok, name, seq, args.device)) for name, seq in records]
        if args.cmd == "pll":
            with open(args.out, "w") as f:
                f.write("id\tpll\n")
                for name, ids in results:
                    f.write(f"{name}\t{pll(model, tok, ids):.4f}\n")
        elif args.cmd == "embed":
            np.savez(args.out, ids=np.array([n for n, _ in results]),
                     embeddings=np.stack([embed(model, ids) for _, ids in results]).astype(np.float32))
        elif args.cmd == "fill":
            with open(args.out, "w") as f:
                for name, ids in results:
                    f.write(f">{name}\n{fill(model, tok, ids)}\n")
        else:
            np.savez(args.out, **{name: contacts(model, tok, name, ids, seq)
                                  for (name, ids), (_, seq) in zip(results, records)})


if __name__ == "__main__":
    main()
