FROM docker.io/pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
RUN pip install --no-cache-dir --break-system-packages transformers==5.20.2 huggingface_hub==2.3.0 numpy==2.5.4
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 ESM2_15B_MODEL=/opt/model
# The weights are facebook/esm2_t48_15B_UR50D's seven fp32 shards (60.5 GB, as
# released) at revision 5fbca39, stored converted to bf16 (about 30 GB), which the
# lab's brief draws the line at and which is the rounding oplm's own computation
# runs on. The machine that builds these images dies on any step that moves about
# a GiB or more, so neither a fetch nor a cast of that size can be one step:
# convert_step.py runs once per group of the manifest's 242 groups -- a short RUN
# each, moving well under a GiB -- and re-fetches only that group's pinned fp32
# byte spans (one resumable, sha256-verified, mirror-falling-back ranged GET per
# tensor), so the fp32 never persists in the image. Every span is checked against
# the sha256 the assembly validation run pinned (campaign ea48d6c1, run 0142e109)
# after bit-verifying it against torch.load(mmap=True) of the assembled,
# whole-sha256-checked shards, and the shard a step writes is proven by loading it
# back: it must hold exactly those tensors and hash to the group's canonical value
# sha256 that run recorded -- torch.save's container bytes are not deterministic
# (run 426380dd), so the pins pin the values: key, dtype, shape, raw bits. A
# stalled step resumes from the bytes it already holds, and a build that dies
# reuses whatever the builder cached. At load the wrapper verifies every shard's
# value pin once per machine and loads the model in bf16 through the shard index.
# The small files -- config, shard index, manifest, tokenizer, vocab, and Meta's
# MIT LICENSE -- are committed in model/ and copied in after the steps, so a
# change to them never invalidates a cached step, and the test is last, per the
# conventions.
COPY convert_step.py manifest.json /tmp/
RUN python3 -I /tmp/convert_step.py 0
