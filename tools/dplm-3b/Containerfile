FROM docker.io/pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 DPLM_MODEL=/opt/model
# The layout dplm-150m's published image proved, with the one deviation this
# checkpoint forces: the weights are airkingbd/dplm_3b's four fp32 shards
# (11.4 GB), fetched one RUN per shard after build.sh, so no single layer
# nears a registry size limit. Everything else is one RUN (build.sh), naming
# each stage as it starts, so a build that dies says where. The environment is
# requirements.txt: the closed set of packages, each wheel sha256-pinned. Each shard is stored
# exactly as released, cast to bf16 at load, the same cast the test's
# reference map was computed with; build.sh lays in the committed files --
# the vendored modeling code under /opt/src, the wrapper on PATH, the license
# beside the weights -- and each fetch prints its redirect hops and a
# heartbeat while its shard streams, so a build that dies mid-download says
# where.
COPY src /incoming/src/
COPY bin /incoming/bin/
COPY LICENSE fetch_weights.py build.sh requirements.txt /incoming/
RUN bash /incoming/build.sh
RUN python3 -I /incoming/fetch_weights.py /opt/model config.json pytorch_model.bin.index.json tokenizer_config.json special_tokens_map.json vocab.txt
RUN python3 -I /incoming/fetch_weights.py /opt/model pytorch_model-00001-of-00004.bin
RUN python3 -I /incoming/fetch_weights.py /opt/model pytorch_model-00002-of-00004.bin
RUN python3 -I /incoming/fetch_weights.py /opt/model pytorch_model-00003-of-00004.bin
RUN python3 -I /incoming/fetch_weights.py /opt/model pytorch_model-00004-of-00004.bin
RUN rm -rf /incoming && ls -l /opt/model
COPY test /toolshed/test
