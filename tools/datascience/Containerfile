# MMseqs2 from master: the fix for #1092 (a prefilter overflow on conserved k-mers, which kills easy-cluster on about
# 1.1M antibody pairs) is in no release yet, 18-8cc5c included; master's build needs Rust 1.68 or later
FROM docker.io/library/rust:1.99.1-slim-bookworm@sha256:392f221964669402bf4ae133d2a46c3ae270f64734133f4b2703d40019235c1a AS mmseqs
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates zlib1g-dev libbz2-dev \
  && git clone https://github.com/soedinglab/MMseqs2.git /src && git -C /src checkout 2a3dafc46f9a1bc79af96b4c11a24d63a7b0b4d4 \
  && cmake -S /src -B /build -DCMAKE_BUILD_TYPE=RELEASE -DHAVE_AVX2=1 && cmake --build /build -j"$(nproc)" --target mmseqs

FROM docker.io/library/python:3.12-slim-bookworm@sha256:0f086103b026048cc50cb5da25ec435c023c5241a83fc44daea593377abc61c4
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates wget libgomp1 libatomic1 \
  && rm -rf /var/lib/apt/lists/* \
  && git config --system --add safe.directory '*'
RUN pip install --no-cache-dir abstar==0.9.0 abutils==0.6.1 numpy==2.5.4 polars==2.1.0 pandas==3.1.1 \
  pyarrow==26.0.1 duckdb==2.0.0 scipy==1.18.1 scikit-learn==1.9.1 biopython==1.88 huggingface_hub==2.4.0 \
  datasets==5.1.0 matplotlib==3.11.2 seaborn==0.13.2
# ANARCII numbers amino-acid antibody sequences; its weights ship in the package. CPU torch keeps the image GPU-free
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple \
  torch==2.15.0+cpu \
  networkx==3.7 sympy==1.14.0 mpmath==1.3.0 jinja2==3.1.6 markupsafe==3.0.4 setuptools==84.2.1 \
  && pip install --no-cache-dir anarcii==2.0.8 gemmi==0.7.5 msgpack==1.2.4 psutil==7.2.2 sortedcontainers==2.4.0
COPY --from=mmseqs /build/src/mmseqs /usr/local/bin/mmseqs
RUN mmseqs version
RUN wget -q -O /tmp/diamond.tgz https://github.com/bbuchfink/diamond/releases/download/v2.2.8/diamond-linux64.tar.gz \
  && echo "33a765d192ae4f5b388f15fe2e7c23d3aaea0f9e3f6872efe8c324aec261fbc7  /tmp/diamond.tgz" | sha256sum -c - \
  && tar -xzf /tmp/diamond.tgz -C /usr/local/bin diamond && rm /tmp/diamond.tgz && diamond version
COPY test /toolshed/test
