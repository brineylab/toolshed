#!/usr/bin/env -S python3 -I
"""esmfold2: fold the jobs in a JSON file with the ESMFold2 model baked into this image.

  esmfold2 predict --in jobs.json --out out [--samples N] [--seed S] [--loops N] [--steps N]

The input is one job or a list of them. A job is {"name": ..., "sequences": [...]} plus, optionally,
"covalent_bonds" and "pocket": esm's own serialized StructurePredictionInput (protein, dna, rna, and ligand
entries), read by esm.utils.structure.input_builder.deserialize_structure_prediction_input. Every job is
checked before the model loads; the model loads once for the whole file. For each job and sample i,
out/<name>_sample_<i>.cif, .json (mean plddt, ptm, iptm, pair_chains_iptm), and .npz (per-token plddt, pae).
"""
import argparse
import json
import os
import sys
from pathlib import Path


def load_jobs(path):
    """The file's jobs, each deserialized, or exit 2 naming the first job that is not one."""
    from esm.utils.structure.input_builder import deserialize_structure_prediction_input

    data = json.loads(Path(path).read_text())
    jobs = data if isinstance(data, list) else [data]
    parsed, seen = [], set()
    for i, job in enumerate(jobs):
        where = f"{path}: job {i}"
        if not isinstance(job, dict) or not isinstance(job.get("name"), str) or not job["name"]:
            sys.exit(f'esmfold2: {where}: missing "name"')
        if "/" in job["name"] or job["name"] in seen:
            sys.exit(f'esmfold2: {where}: name {job["name"]!r} has a "/" or repeats another job\'s')
        seen.add(job["name"])
        try:
            parsed.append((job["name"], deserialize_structure_prediction_input(job)))
        except (KeyError, TypeError, ValueError) as e:
            sys.exit(f"esmfold2: {where} ({job['name']}): not an ESMFold2 input: {type(e).__name__}: {e}")
    return parsed


def write(stem, result):
    import numpy as np

    stem.with_suffix(".cif").write_text(result.complex.to_mmcif())
    plddt = result.plddt.float().numpy()
    pair = result.pair_chains_iptm
    stem.with_suffix(".json").write_text(json.dumps({
        "plddt": float(plddt.mean()), "ptm": result.ptm, "iptm": result.iptm,
        "pair_chains_iptm": None if pair is None else pair.float().tolist(),
    }, indent=1) + "\n")
    arrays = {"plddt": plddt}
    if result.pae is not None:
        arrays["pae"] = result.pae.float().numpy()
    np.savez_compressed(stem.with_suffix(".npz"), **arrays)


def predict(args):
    jobs = load_jobs(args.inp)
    import torch
    from esm.models.esmfold2 import ESMFold2InputBuilder, EsmFold2Model

    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    model = EsmFold2Model.from_pretrained(os.environ["ESMFOLD2_MODEL"], device="cuda").eval()
    builder = ESMFold2InputBuilder()
    with torch.inference_mode():
        for name, inp in jobs:
            results = builder.fold(model, inp, num_loops=args.loops, num_sampling_steps=args.steps,
                                   num_diffusion_samples=args.samples, seed=args.seed, complex_id=name)
            for i, result in enumerate(results if isinstance(results, list) else [results]):
                write(out / f"{name}_sample_{i}", result)
            print(f"{name}: {args.samples} sample(s) written to {out}", flush=True)


def main():
    ap = argparse.ArgumentParser(prog="esmfold2", description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="command", required=True)
    p = sub.add_parser("predict", help="fold every job in a JSON file")
    p.add_argument("--in", dest="inp", required=True, help="a job or a list of jobs, as JSON")
    p.add_argument("--out", required=True, help="directory for the predictions; created if missing")
    p.add_argument("--samples", type=int, default=1, help="diffusion samples per job (default 1)")
    p.add_argument("--seed", type=int, default=0, help="seed for input preparation and sampling (default 0)")
    p.add_argument("--loops", type=int, default=int(os.environ["ESMFOLD2_LOOPS"]),
                   help="trunk recycling loops (default $ESMFOLD2_LOOPS, %(default)s)")
    p.add_argument("--steps", type=int, default=int(os.environ["ESMFOLD2_STEPS"]),
                   help="diffusion sampling steps (default $ESMFOLD2_STEPS, %(default)s)")
    predict(ap.parse_args())


if __name__ == "__main__":
    main()
