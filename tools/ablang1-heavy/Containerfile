FROM docker.io/pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 ABLANG1_MODEL=/opt/ablang ABLANG1_CHAIN=heavy \
    RANK= WORLD_SIZE= LOCAL_RANK=
RUN pip uninstall -y --break-system-packages torchaudio torchvision && \
    pip install --no-cache-dir --break-system-packages \
      ablang==0.3.1 numpy==2.5.5 requests==2.33.1 pandas==3.0.5 \
      numba==0.67.0 llvmlite==0.49.0 python-dateutil==2.9.0.post0 \
      pytz==2026.6 tzdata==2026.6 six==1.17.0 && \
    python3 -I -c "import torch, ablang"
COPY fetch_weights.py /tmp/fetch_weights.py
RUN python3 -I /tmp/fetch_weights.py heavy /opt/ablang && rm /tmp/fetch_weights.py
COPY LICENSE /opt/ablang/LICENSE
COPY --chmod=755 bin/ablang1-heavy /usr/local/bin/ablang1-heavy
COPY test /toolshed/test
