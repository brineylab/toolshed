#!/usr/bin/env -S python3 -I
"""AbLang1 single-chain pseudo-log-likelihoods, embeddings, infilling and matrices."""
import argparse
import os
import sys
import time

import ablang
import numpy as np
import torch

RESIDUES = "ACDEFGHIKLMNPQRSTVWY"
BATCH = 32


def read_fasta(path, allow_mask=False):
    records = []
    with open(path) as handle:
        for line in handle:
            line = line.strip()
            if line.startswith(">"):
                name = line[1:].split()[0] if line[1:].strip() else f"seq{len(records) + 1}"
                if any(name == old for old, _ in records):
                    sys.exit(f"{NAME}: {name} appears twice in {path}; ids must be unique")
                records.append([name, ""])
            elif line:
                if not records:
                    sys.exit(f"{NAME}: {path} is not FASTA: sequence before the first '>'")
                records[-1][1] += line.upper().replace("<MASK>", "*") if allow_mask else line.upper()
    if not records:
        sys.exit(f"{NAME}: {path} holds no sequences")
    for name, sequence in records:
        outside = "".join(sorted(set(sequence) - set(RESIDUES + ("*" if allow_mask else ""))))
        if outside or not sequence.replace("*", ""):
            sys.exit(f"{NAME}: {name} is empty or holds unsupported characters: {outside}")
        if len(sequence) > MAX_RESIDUES:
            sys.exit(f"{NAME}: {name} has {len(sequence)} residues; the training input takes at most {MAX_RESIDUES}")
    return records


def encode(model, sequence, device):
    # ablang.ABtokenizer.encode: '<' + the original residues + '>'. The package
    # has no paired constructor and freezes ordinary residues during restore.
    ids = model.tokenizer(sequence.replace("*", "M"), pad=True, device=device).unsqueeze(0)
    positions = torch.arange(1, len(sequence) + 1, device=device)
    masked = torch.tensor([residue == "*" for residue in sequence], device=device)
    ids[0, positions[masked]] = model.tokenizer.vocab_to_token["*"]
    return ids, positions, masked


def residue_logp(model, tokens):
    ids, positions, _ = tokens
    rows = []
    for start in range(0, len(positions), BATCH):
        pos = positions[start:start + BATCH]
        index = torch.arange(len(pos), device=ids.device)
        batch = ids.repeat((len(pos), 1))
        batch[index, pos] = model.tokenizer.vocab_to_token["*"]
        predictions = model.AbLang(batch)
        # Upstream's likelihood head exposes its 20 logit columns directly.
        # Normalizing those columns leaves the predicted residue unchanged.
        rows.append(predictions[index, pos, 1:21].log_softmax(-1))
    return torch.cat(rows).float().cpu().numpy()


def embedding(model, tokens):
    ids, positions, _ = tokens
    hidden = model.AbRep(ids).last_hidden_states[0, positions]
    return hidden.mean(0).float().cpu().numpy()


def fill(model, sequence, tokens):
    ids, _, _ = tokens
    # Adapt only the interface: upstream restore predicts once and preserves all
    # non-'*' input tokens. It uses the 20 logits directly, without a softmax.
    predictions = model.AbLang(ids)[:, :, 1:21]
    predicted_tokens = torch.max(predictions, -1).indices + 1
    restored_tokens = torch.where(ids == model.tokenizer.vocab_to_token["*"], predicted_tokens, ids)
    residues = list(sequence.replace("*", "M"))
    for index, is_masked in enumerate(tokens[2].tolist()):
        if is_masked:
            token = int(restored_tokens[0, index + 1]) - 1
            residues[index] = "MRHKDESTNQCGPAVIFYWL"[token]
    return "".join(residues)


def main():
    parser = argparse.ArgumentParser(prog=NAME, description=__doc__)
    sub = parser.add_subparsers(dest="cmd", required=True)
    for command, output in (("pll", "TSV: id, pll"), ("embed", "npz: ids, embeddings"),
                            ("fill", "FASTA"), ("matrix", "npz: per-id (L, 20) log-probabilities")):
        p = sub.add_parser(command)
        p.add_argument("--in", dest="inp", required=True, help="single-chain FASTA")
        p.add_argument("--out", required=True, help=output)
        p.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
    args = parser.parse_args()
    if args.device == "cuda" and not torch.cuda.is_available():
        sys.exit(f"{NAME}: --device cuda was requested, but no CUDA device is available")
    records = read_fasta(args.inp, allow_mask=args.cmd == "fill")
    read_time = time.monotonic()
    model = ablang.pretrained(chain=CHAIN, model_folder=os.environ["ABLANG1_MODEL"],
                              random_init=False, ncpu=1, device=args.device)
    model.freeze()
    loaded_time = time.monotonic()
    residues = sum(len(sequence) for _, sequence in records)
    print(f"{NAME}: {len(records)} sequence(s), {residues} residues; device={args.device}; "
          f"model_load_seconds={loaded_time - read_time:.3f}; input_bytes={os.path.getsize(args.inp)}", flush=True)
    tokens = [encode(model, sequence, args.device) for _, sequence in records]
    with torch.inference_mode():
        if args.cmd == "embed":
            np.savez(args.out, ids=np.array([name for name, _ in records]),
                     embeddings=np.stack([embedding(model, token) for token in tokens]).astype(np.float32))
        elif args.cmd == "fill":
            with open(args.out, "w") as handle:
                for (name, sequence), token in zip(records, tokens):
                    handle.write(f">{name}\n{fill(model, sequence, token)}\n")
        else:
            matrices = [residue_logp(model, token) for token in tokens]
            if args.cmd == "pll":
                with open(args.out, "w") as handle:
                    handle.write("id\tpll\n")
                    for (name, sequence), matrix in zip(records, matrices):
                        columns = np.array([RESIDUES.index(residue) for residue in sequence])
                        handle.write(f"{name}\t{matrix[np.arange(len(columns)), columns].sum():.6f}\n")
            else:
                maps = {name: matrix.astype(np.float32) for (name, _), matrix in zip(records, matrices)}
                np.savez(args.out, ids=np.array([name for name, _ in records]),
                         amino_acids=np.array(list(RESIDUES)), **maps)
    compute_seconds = time.monotonic() - loaded_time
    print(f"{NAME}: compute_seconds={compute_seconds:.3f}; "
          f"residues_per_second={residues / compute_seconds:.3f}", flush=True)
    if args.device == "cuda":
        print(f"{NAME}: gpu={torch.cuda.get_device_name(0)}; "
              f"peak_gpu_memory_gib={torch.cuda.max_memory_allocated() / 2**30:.3f}", flush=True)


if __name__ == "__main__":
    CHAIN = os.path.basename(sys.argv[0]).removeprefix("ablang1-")
    if CHAIN not in ("heavy", "light"):
        raise RuntimeError(f"unexpected AbLang1 executable name: {sys.argv[0]}")
    NAME = f"ablang1-{CHAIN}"
    MAX_RESIDUES = {"heavy": 128, "light": 127}[CHAIN]
    main()
