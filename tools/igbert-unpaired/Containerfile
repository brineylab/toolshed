FROM docker.io/pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 IGBERT_UNPAIRED_MODEL=/opt/model
RUN pip uninstall -y --break-system-packages torchaudio torchvision && \
    pip install --no-cache-dir --break-system-packages \
      transformers==5.16.1 numpy==2.5.4 requests==2.33.1 && \
    python3 -I -c "import torch, transformers; \
      from transformers import BertForMaskedLM, BertTokenizer"
RUN HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 python3 -I -c "from huggingface_hub import snapshot_download; \
    snapshot_download('Exscientia/IgBert_unpaired', revision='53ed1be4a09fd30ef3f21ba0c8aae778ccdfff74', \
    local_dir='/opt/model', allow_patterns=['config.json', 'model.safetensors', 'vocab.txt', \
    'tokenizer_config.json', 'special_tokens_map.json'])"
COPY LICENSE /opt/model/LICENSE
COPY --chmod=755 bin/igbert-unpaired /usr/local/bin/igbert-unpaired
COPY test /toolshed/test
