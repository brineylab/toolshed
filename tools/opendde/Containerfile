# OpenDDE 1.2.0 on PyTorch 2.7.1 (the version opendde pins), on the CUDA 12.8 build of that release rather than
# upstream's cu126: cu126 wheels carry no Blackwell (sm_100) kernels, which is what broke boltz-2 1.0.1 on a B200.
FROM docker.io/pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
# Triton compiles a small C driver shim on first use (cuEquivariance's kernels past 100 residues); the runtime
# base has no C compiler.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*
# torch==2.7.1 is already the base's cu128 build, so pip keeps it; the gpu extra pins triton 3.3.1 and cuEquivariance 0.10.0.
RUN pip install --no-cache-dir "opendde[gpu]==1.2.0"
# OPENDDE_ROOT_DIR holds what `opendde pred` would otherwise download: the general-purpose checkpoint and the
# CCD-derived common files, from the revision opendde 1.2.0's manifest pins, each checked against the size and
# sha256 opendde itself verifies (opendde/config/model_manifest.json, opendde/config/dependency_url.py).
ENV OPENDDE_ROOT_DIR=/opt/opendde HF_HUB_OFFLINE=1
RUN python3 -I -c "import hashlib, pathlib, urllib.request; \
base = 'https://huggingface.co/aurekaresearch/OpenDDE/resolve/eddd563ce96571f784012edd8f045181c8f8627d/'; \
root = pathlib.Path('/opt/opendde'); \
files = { \
  'checkpoint/opendde.pt': ('opendde.pt', 2625249069, '7b826620390afad877ee2babc6a4d0df81b94d3a0be030959853d6a7da0807cc'), \
  'common/components.cif': ('common/components.cif', 490777362, 'bb31ae5cf6c8bc669924313077cb4231ee5ffefd3a20118cd14f3ec89f8bb6a5'), \
  'common/components.cif.rdkit_mol.pkl': ('common/components.cif.rdkit_mol.pkl', 142498117, 'd1cfb71f5993a3ebea7c47877022d7f597bbfbaf86e28a4770e957da6c50cd35'), \
  'common/obsolete_to_successor.json': ('common/obsolete_to_successor.json', 86882, '2bc08348d0efba438c109bb27be6fa25b611d371c60b8a8da3de387a4a0698ad'), \
  'common/release_date_cache.json': ('common/release_date_cache.json', 12754898, '8b1ef12ddc01a0d5eb2d388c77ded91aa906eebce7440726c57b6f8d1a3ec142'), \
}; \
[(dst := root / rel).parent.mkdir(parents = True, exist_ok = True) or urllib.request.urlretrieve(base + src, dst) for rel, (src, size, sha) in files.items()]; \
bad = [rel for rel, (src, size, sha) in files.items() if (root / rel).stat().st_size != size or hashlib.sha256((root / rel).read_bytes()).hexdigest() != sha]; \
assert not bad, f'size or sha256 mismatch: {bad}'; print('verified', len(files), 'files')"
COPY LICENSE /opt/opendde/
COPY test /toolshed/test
