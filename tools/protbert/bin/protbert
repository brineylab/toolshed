#!/usr/bin/env -S python3 -I
"""protbert: contact maps from ProtBERT's categorical Jacobian, computed the way oplm does."""
from __future__ import annotations

import argparse
import hashlib
import os
import sys
import tempfile
from typing import Callable

import numpy as np
import torch
# Explicit classes, not Auto*: Rostlab/prot_bert's config.json carries no
# model_type, so transformers 5.x AutoConfig cannot resolve it, and
# AutoTokenizer falls back to a generic backend that cannot read vocab.txt.
from transformers import BertForMaskedLM, BertTokenizer
from transformers.utils import logging

logging.disable_progress_bar()

# The contact computation below is oplm's, copied verbatim from
# github.com/briney/oplm at commit 704e01f5ed4b8322bb82e0c961b2c16361c47fa2:
# CANONICAL_AMINO_ACIDS, compute_categorical_jacobian, center_categorical_jacobian,
# symmetrize_categorical_jacobian and categorical_jacobian_to_contact_map from
# src/oplm/eval/metrics/categorical_jacobian.py, and apply_apc from
# src/oplm/eval/metrics/contact.py.

# Matches the canonical amino-acid token ordering used by ESM-family models.
CANONICAL_AMINO_ACIDS: tuple[str, ...] = (
    "L",
    "A",
    "G",
    "V",
    "S",
    "E",
    "R",
    "T",
    "I",
    "D",
    "P",
    "K",
    "Q",
    "N",
    "F",
    "Y",
    "M",
    "H",
    "W",
    "C",
)

MAX_RESIDUES = 818   # the longest sequence the contacts command takes
MUTATION_BATCH = 32  # mutant sequences per forward pass

# The image ships the fp32 checkpoint as thirteen sha256-verified 128 MiB
# chunks, each fetched by one short build step (tools/protbert/fetch_chunk.py),
# because the machine that builds this image dies on single steps that move
# gigabytes. The first run assembles them, checks the whole file's sha256,
# and caches it under the system's temp directory; loaded with
# dtype=bfloat16, the fp32 bytes are the same bf16 weights a converted file
# would hold.
CHECKPOINT_SHA256 = "6ea3edd26cfefc3111176100ee2a027ed510f9c86b63e5b53a2a050b59f2af9d"
CHECKPOINT_BYTES = 1684058277
CHECKPOINT_PARTS = 13
SMALL_MODEL_FILES = ("config.json", "vocab.txt", "tokenizer_config.json", "special_tokens_map.json")


def loadable_model_dir():
    """A directory transformers loads this model from.

    $PROTBERT_MODEL when it already holds pytorch_model.bin; otherwise one
    whose pytorch_model.bin is the image's committed chunks, assembled and
    sha256-verified once and cached under the system's temp directory.
    """
    src = os.environ["PROTBERT_MODEL"]
    if os.path.exists(os.path.join(src, "pytorch_model.bin")):
        return src
    parts = [os.path.join(src, "pytorch_model.bin.part%02d" % i) for i in range(CHECKPOINT_PARTS)]
    missing = [p for p in parts if not os.path.exists(p)]
    if missing:
        sys.exit("protbert: the image is missing checkpoint chunks: %s" % ", ".join(missing))
    held = sum(os.path.getsize(p) for p in parts)
    if held != CHECKPOINT_BYTES:
        sys.exit("protbert: the image's checkpoint chunks hold %d bytes, not the pinned %d"
                 % (held, CHECKPOINT_BYTES))
    cache = os.path.join(tempfile.gettempdir(), "protbert-pytorch_model-%s.bin" % CHECKPOINT_SHA256[:16])
    if not os.path.exists(cache):
        digest = hashlib.sha256()
        fd, tmp = tempfile.mkstemp(prefix=".protbert-assemble-", dir=tempfile.gettempdir())
        try:
            with os.fdopen(fd, "wb") as out:
                for part in parts:
                    with open(part, "rb") as f:
                        for block in iter(lambda: f.read(8 << 20), b""):
                            digest.update(block)
                            out.write(block)
                out.flush()
            if digest.hexdigest() != CHECKPOINT_SHA256:
                sys.exit("protbert: the assembled checkpoint hashes to %s, not the pinned %s"
                         % (digest.hexdigest(), CHECKPOINT_SHA256))
            os.chmod(tmp, 0o644)
            os.replace(tmp, cache)
        finally:
            if os.path.exists(tmp):
                os.remove(tmp)
        print("protbert: assembled and verified the checkpoint at %s" % cache, file=sys.stderr)
    model_dir = tempfile.mkdtemp(prefix="protbert-model-")
    for name in SMALL_MODEL_FILES:
        os.symlink(os.path.join(src, name), os.path.join(model_dir, name))
    os.symlink(cache, os.path.join(model_dir, "pytorch_model.bin"))
    return model_dir


def apply_apc(matrix: torch.Tensor) -> torch.Tensor:
    """Average Product Correction, oplm's src/oplm/eval/metrics/contact.py."""
    row_mean = matrix.mean(dim=-1, keepdim=True)  # (L, 1)
    col_mean = matrix.mean(dim=-2, keepdim=True)  # (1, L)
    global_mean = matrix.mean()

    if global_mean.abs() < 1e-8:
        return matrix

    return matrix - (row_mean * col_mean) / global_mean


def compute_categorical_jacobian(
    wildtype_input_ids: torch.Tensor,
    wildtype_logits: torch.Tensor,
    canonical_token_ids: torch.Tensor,
    logits_fn: Callable[[torch.Tensor], torch.Tensor],
    mutation_batch_size: int = 20,
) -> torch.Tensor:
    """Compute the categorical Jacobian via batched finite differences.

    Args:
        wildtype_input_ids: Wild-type token IDs including special tokens,
            shape ``(T,)``.
        wildtype_logits: Wild-type logits restricted to canonical amino-acid
            output channels, shape ``(L, A)``.
        canonical_token_ids: Canonical amino-acid token IDs, shape ``(A,)``.
        logits_fn: Function mapping a batch of mutated token IDs ``(B, T)``
            to canonical-channel logits ``(B, L, A)``.
        mutation_batch_size: Number of mutant sequences per forward pass.

    Returns:
        Tensor of shape ``(L, A, L, A)`` containing ``mutant - wildtype``
        logit deltas for every input-position/amino-acid mutation.
    """
    if mutation_batch_size < 1:
        raise ValueError("mutation_batch_size must be >= 1")

    if wildtype_input_ids.ndim != 1:
        raise ValueError("wildtype_input_ids must have shape (T,)")
    if wildtype_logits.ndim != 2:
        raise ValueError("wildtype_logits must have shape (L, A)")
    if canonical_token_ids.ndim != 1:
        raise ValueError("canonical_token_ids must have shape (A,)")

    seq_len, alphabet_size = wildtype_logits.shape
    if canonical_token_ids.shape[0] != alphabet_size:
        raise ValueError("canonical_token_ids length must match wildtype_logits.shape[1]")
    if wildtype_input_ids.shape[0] < seq_len + 2:
        raise ValueError("wildtype_input_ids must include leading and trailing special tokens")

    input_ids_cpu = wildtype_input_ids.cpu()
    canonical_ids_cpu = canonical_token_ids.cpu()
    wildtype_logits_cpu = wildtype_logits.cpu().float()

    jacobian = torch.empty((seq_len, alphabet_size, seq_len, alphabet_size), dtype=torch.float32)
    n_mutants = seq_len * alphabet_size

    for start in range(0, n_mutants, mutation_batch_size):
        stop = min(start + mutation_batch_size, n_mutants)
        batch_size = stop - start
        flat_indices = torch.arange(start, stop, dtype=torch.long)
        position_indices = torch.div(flat_indices, alphabet_size, rounding_mode="floor")
        amino_acid_indices = torch.remainder(flat_indices, alphabet_size)

        batch_input_ids = input_ids_cpu.unsqueeze(0).repeat(batch_size, 1)
        batch_rows = torch.arange(batch_size, dtype=torch.long)
        batch_input_ids[batch_rows, position_indices + 1] = canonical_ids_cpu[amino_acid_indices]

        batch_logits = logits_fn(batch_input_ids).cpu().float()
        expected_shape = (batch_size, seq_len, alphabet_size)
        if tuple(batch_logits.shape) != expected_shape:
            raise ValueError(
                f"logits_fn returned shape {tuple(batch_logits.shape)}, expected {expected_shape}"
            )

        jacobian[position_indices, amino_acid_indices] = (
            batch_logits - wildtype_logits_cpu.unsqueeze(0)
        )

    return jacobian


def center_categorical_jacobian(categorical_jacobian: torch.Tensor, copy: bool = True) -> torch.Tensor:
    """Mean-center a categorical Jacobian across each of its four axes."""
    centered = categorical_jacobian.clone() if copy else categorical_jacobian
    centered = centered.float()
    for dim in range(4):
        centered -= centered.mean(dim=dim, keepdim=True)
    return centered


def symmetrize_categorical_jacobian(categorical_jacobian: torch.Tensor) -> torch.Tensor:
    """Symmetrize a categorical Jacobian over input/output residue pairs."""
    return (categorical_jacobian + categorical_jacobian.permute(2, 3, 0, 1)) / 2


def categorical_jacobian_to_contact_map(
    categorical_jacobian: torch.Tensor,
    center: bool = True,
    symmetrize: bool = True,
    apc: bool = True,
    copy: bool = True,
) -> torch.Tensor:
    """Reduce a categorical Jacobian to an ``(L, L)`` contact score map."""
    jacobian = categorical_jacobian.clone() if copy else categorical_jacobian
    jacobian = jacobian.float()

    if center:
        jacobian = center_categorical_jacobian(jacobian, copy=False)
    if symmetrize:
        jacobian = symmetrize_categorical_jacobian(jacobian)

    contact_scores = torch.sqrt(torch.square(jacobian).sum(dim=(1, 3)))
    contact_scores.fill_diagonal_(0.0)

    if apc:
        contact_scores = apply_apc(contact_scores)
    if symmetrize:
        contact_scores = (contact_scores + contact_scores.T) / 2

    return contact_scores


def read_fasta(path):
    records = []
    for line in open(path):
        line = line.strip()
        if line.startswith(">"):
            records.append([line[1:].split()[0] if line[1:].strip() else f"seq{len(records) + 1}", ""])
        elif line:
            if not records:
                sys.exit(f"protbert: {path} is not FASTA: sequence before the first '>'")
            records[-1][1] += line.upper()
    if not records:
        sys.exit(f"protbert: {path} holds no sequences")
    return records


def check_sequence(name, seq):
    if not seq:
        sys.exit(f"protbert: {name} is empty")
    if len(seq) > MAX_RESIDUES:
        sys.exit(f"protbert: {name} has {len(seq)} residues; the contacts command takes at most {MAX_RESIDUES}")
    bad = sorted(set(seq) - set(CANONICAL_AMINO_ACIDS))
    if bad:
        sys.exit(f"protbert: {name} holds {''.join(bad)}; the contacts command takes only the 20 canonical amino acids")


def canonical_token_ids(tok):
    """One token id per amino acid in CANONICAL_AMINO_ACIDS order, one token each."""
    ids = []
    for letter in CANONICAL_AMINO_ACIDS:
        # a list input, so input_ids is always a batch: transformers 5.x returns
        # a flat id list for a single string and a list of lists for a list
        encoded = tok([letter], add_special_tokens=False)["input_ids"]
        if len(encoded) != 1 or len(encoded[0]) != 1:
            sys.exit(f"protbert: the tokenizer splits {letter} into {encoded}")
        ids.append(encoded[0][0])
    if tok.unk_token_id in ids:
        sys.exit(f"protbert: the tokenizer has no token for a canonical amino acid: {ids}")
    return torch.tensor(ids, dtype=torch.long)


def encode(tok, name, seq):
    """Token ids for ProtBERT's space-separated residues: [CLS] one per residue [SEP]."""
    ids = tok(" ".join(seq), return_tensors="pt")["input_ids"][0]
    if (ids.shape[0] != len(seq) + 2 or ids[0] != tok.cls_token_id or ids[-1] != tok.sep_token_id):
        sys.exit(f"protbert: {name} does not tokenize to one token per residue "
                 f"({ids.shape[0]} tokens for {len(seq)} residues)")
    return ids


def contacts(model, tok, canonical_ids, name, seq, device):
    """One (L, L) float32 contact map: the categorical Jacobian, reduced as oplm does."""
    L = len(seq)
    ids = encode(tok, name, seq)
    canonical_device = canonical_ids.to(device)
    with torch.no_grad():
        logits = model(input_ids=ids.unsqueeze(0).to(device)).logits
    wildtype = logits[0, 1:L + 1].index_select(-1, canonical_device).detach().cpu().float()

    def logits_fn(batch_input_ids):
        batch = batch_input_ids.to(device)
        with torch.no_grad():
            out = model(input_ids=batch).logits
        return out[:, 1:L + 1].index_select(-1, canonical_device)

    jacobian = compute_categorical_jacobian(
        wildtype_input_ids=ids,
        wildtype_logits=wildtype,
        canonical_token_ids=canonical_ids,
        logits_fn=logits_fn,
        mutation_batch_size=MUTATION_BATCH,
    )
    return categorical_jacobian_to_contact_map(jacobian).numpy().astype(np.float32)


def main():
    ap = argparse.ArgumentParser(prog="protbert", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("contacts", help="npz: one (L, L) float32 contact map per sequence")
    p.add_argument("--in", dest="inp", required=True, help="FASTA")
    p.add_argument("--out", required=True, help="npz of contact maps")
    p.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
    args = ap.parse_args()

    records = read_fasta(args.inp)
    path = loadable_model_dir()
    tok = BertTokenizer.from_pretrained(path)
    model = BertForMaskedLM.from_pretrained(
        path, dtype=torch.bfloat16
    ).eval().to(args.device)
    canonical_ids = canonical_token_ids(tok)
    maps = {}
    for name, seq in records:
        check_sequence(name, seq)
        maps[name] = contacts(model, tok, canonical_ids, name, seq, args.device)
        if args.device == "cuda":
            torch.cuda.empty_cache()
    np.savez(args.out, **maps)


if __name__ == "__main__":
    main()
