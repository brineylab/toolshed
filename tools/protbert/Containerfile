FROM docker.io/pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
RUN pip install --no-cache-dir --break-system-packages transformers==5.20.2 huggingface_hub==2.3.0 numpy==2.5.4
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PROTBERT_MODEL=/opt/model
# scripts/build passes HF_TOKEN as the build secret hf_token; the Hub throttles anonymous
# downloads, so use it when it is there and retry either way. An empty token means anonymous,
# and the secret never reaches a layer.
RUN --mount=type=secret,id=hf_token \
    for i in 1 2 3 4 5; do \
      if HF_TOKEN=$(cat /run/secrets/hf_token 2>/dev/null || true) HF_HUB_OFFLINE=0 \
        python3 -I -c "from huggingface_hub import snapshot_download; snapshot_download('Rostlab/prot_bert', revision='7a894481acdc12202f0a415dd567f6cfdb698908', local_dir='/opt/model', allow_patterns=['*.json', '*.txt', 'pytorch_model.bin'])"; then \
        exit 0; \
      fi; \
      echo "weights download attempt $i of 5 failed; retrying in 30s" >&2; \
      sleep 30; \
    done; \
    exit 1
COPY LICENSE /opt/model/LICENSE
COPY --chmod=755 bin/protbert /usr/local/bin/protbert
COPY test /toolshed/test
